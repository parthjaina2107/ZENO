# Google Gemini API Key (Get free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Local by default. Use free-cloud-local ONLY with a billing-disabled Free-tier
# AI Studio project, then explicitly set GEMINI_FREE_TIER_CONFIRMED=true.
LLM_MODE=local
GEMINI_FREE_TIER_CONFIRMED=false
LOCAL_LLM_ENABLED=true
OLLAMA_MODEL=qwen3:4b
OLLAMA_VISION_MODEL=qwen3-vl:2b
OLLAMA_TIMEOUT_SECONDS=90
# Separate Codex service is not covered by free-tier Gemini/local routing.
CODING_ALLOW_EXTERNAL=false

# Local Windows speech by default. Optional edge requires requirements-awareness.txt
# and sends spoken text to Microsoft's online speech service.
TTS_BACKEND=sapi
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=-12%
TTS_VOLUME=-15%
TTS_PITCH=-2Hz
TTS_LOCAL_VOICE=Zira

# Proactive updates while ZENO is running (not an always-on Windows service).
AWARENESS_ENABLED=true
AWARENESS_POLL_SECONDS=60
BRIEFING_INTERVAL_SECONDS=900
# Optional, e.g. 22:00-08:00. Empty means no scheduled quiet hours.
QUIET_HOURS=
# WATCH_PROJECTS=C:\path\to\repo;C:\path\to\another-repo
# OUTLOOK_CLIENT_ID=your-desktop-app-client-id

# Ngrok Auth Token (Get free at https://ngrok.com/ for remote mobile access)
NGROK_AUTH_TOKEN=

# Secret access token/passphrase for remote mobile login
ACCESS_TOKEN=change_me_to_a_secure_passphrase

# Secret key for JWT session encryption
JWT_SECRET_KEY=change_me_to_a_random_secret_key

# Optional Settings
WHISPER_MODEL=base
# Run --setup-speech once to download the model. No downloads during listening.
STT_BACKEND=faster-whisper
# Empty detects language automatically; set en or hi to constrain recognition.
STT_LANGUAGE=
# When local recognition fails, Google fallback sends audio online.
STT_ALLOW_ONLINE_FALLBACK=false
# Optional transcript-based wake gate (requires cached local Whisper model).
WAKE_WORD_ENABLED=false
VOICE_FOLLOWUP_SECONDS=30
# Headphones only: local recognition of stop/wait during speech. No echo cancellation.
VOICE_BARGE_IN=false
SERVER_PORT=8765
SERVER_HOST=0.0.0.0
LISTEN_TIMEOUT=5
PHRASE_TIMEOUT=10
AGENT_MAX_STEPS=12
AGENT_MAX_ROUNDS=4
AGENT_TIMEOUT=180
LOG_FILE=voiceagent.log

# Native coding-workspace specialist (requires Codex CLI signed in separately).
# Empty executable paths use automatic detection. Empty model uses Codex's default.
CODING_CODEX_PATH=
CODING_VSCODE_PATH=
CODING_MODEL=
CODING_TIMEOUT_SECONDS=900
