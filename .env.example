# Google Gemini API Key (Get free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Softer female neural speech; requires requirements-awareness.txt and internet.
# Spoken text is sent to Microsoft's online speech service. Use sapi for local speech.
TTS_BACKEND=edge
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=-12%
TTS_VOLUME=-15%
TTS_PITCH=-2Hz
TTS_LOCAL_VOICE=Zira

# Proactive updates while ZENO is running (not an always-on Windows service).
AWARENESS_ENABLED=true
AWARENESS_POLL_SECONDS=60
BRIEFING_INTERVAL_SECONDS=900
# Optional, e.g. 22:00-08:00. Empty means no scheduled quiet hours.
QUIET_HOURS=
# WATCH_PROJECTS=C:\path\to\repo;C:\path\to\another-repo
# OUTLOOK_CLIENT_ID=your-desktop-app-client-id

# Ngrok Auth Token (Get free at https://ngrok.com/ for remote mobile access)
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here

# Secret access token/passphrase for remote mobile login
ACCESS_TOKEN=change_me_to_a_secure_passphrase

# Secret key for JWT session encryption
JWT_SECRET_KEY=change_me_to_a_random_secret_key

# Optional Settings
WHISPER_MODEL=base
# Run --setup-speech once to download the model. No downloads during listening.
STT_BACKEND=faster-whisper
# Empty detects language automatically; set en or hi to constrain recognition.
STT_LANGUAGE=
# When local recognition fails, Google fallback sends audio online.
STT_ALLOW_ONLINE_FALLBACK=true
SERVER_PORT=8765
SERVER_HOST=0.0.0.0
LISTEN_TIMEOUT=5
PHRASE_TIMEOUT=10
LOG_FILE=voiceagent.log
